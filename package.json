{
  "name": "engineering-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": "22.23.1"
  },
  "bin": {
    "ecp": "src/cli/main.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && biome check . && vitest run",
